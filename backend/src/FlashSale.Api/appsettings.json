{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost\\SQLEXPRESS;Database=FlashSaleEngine;Trusted_Connection=True;MultipleActiveResultSets=True;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "flash-sale-api",
    "Audience": "flash-sale-client",
    "// SigningKey": "Intentionally empty. Supply it locally with: dotnet user-secrets set \"Jwt:SigningKey\" \"<40+ random chars>\"",
    "SigningKey": "",
    "AccessTokenMinutes": 60,
    "CheckoutPassSeconds": 120,
    "ClockSkewSeconds": 30
  },
  "Queue": {
    "TickSeconds": 10,
    "MaxAdmissionsPerTick": 100,
    "DefaultCheckoutWindowSeconds": 120
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  }
}
